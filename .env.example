# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server only. Never expose to the browser or commit.
SUPABASE_SERVICE_ROLE_KEY=

# Public base URL of this app (used for password-reset links and job triggers)
APP_URL=http://localhost:3000

# 32+ random bytes, base64. Encrypts WhatsApp access tokens at rest.
LB_SECRETS_KEY=
# Shared secret for /api/jobs/run (Vercel Cron / pg_cron)
CRON_SECRET=

# WhatsApp Business Platform (Cloud API)
WHATSAPP_VERIFY_TOKEN=
# Meta App → Settings → Basic → App secret (validates X-Hub-Signature-256)
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_VERSION=v23.0
